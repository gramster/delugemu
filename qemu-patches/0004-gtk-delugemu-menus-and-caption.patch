+    help_menu_item = gtk_menu_item_new_with_mnemonic(_("Help"));
+    gtk_menu_item_set_submenu(GTK_MENU_ITEM(help_menu_item),
+                              gd_create_menu_help(s));
+    gtk_menu_shell_append(GTK_MENU_SHELL(s->menu_bar), help_menu_item);
