+/* DelugEmu Help-menu actions. Launcher-dependent locations (the SD card
+ * folder, an overriding help document) arrive via environment variables
+ * exported by run.sh / delugemu.ps1, so the same binary serves the repo
+ * tree and the packaged bundles. */
+static void gd_delugemu_open_uri(GtkDisplayState *s, const char *uri)
+{
+    gtk_show_uri_on_window(GTK_WINDOW(s->window), uri, GDK_CURRENT_TIME, NULL);
+}
+
+static void gd_menu_delugemu_help(GtkMenuItem *item, void *opaque)
+{
+    GtkDisplayState *s = opaque;
+    const char *url = getenv("DELUGEMU_HELP_URL");
+
+    gd_delugemu_open_uri(s, url && url[0] ? url :
+                         "https://github.com/gramster/delugemu#readme");
+}
+
+static void gd_menu_delugemu_repo(GtkMenuItem *item, void *opaque)
+{
+    gd_delugemu_open_uri(opaque, "https://github.com/gramster/delugemu");
+}
+
+static void gd_menu_delugemu_sd_folder(GtkMenuItem *item, void *opaque)
+{
+    GtkDisplayState *s = opaque;
+    const char *dir = getenv("DELUGEMU_SD_FOLDER");
+    gchar *uri;
+
+    if (!dir || !dir[0]) {
+        return;
+    }
+    uri = g_filename_to_uri(dir, NULL, NULL);
+    if (uri) {
+        gd_delugemu_open_uri(s, uri);
+        g_free(uri);
+    }
+}
+
+static void gd_menu_delugemu_about(GtkMenuItem *item, void *opaque)
+{
+    GtkDisplayState *s = opaque;
+
+    gtk_show_about_dialog(GTK_WINDOW(s->window),
+        "program-name", "DelugEmu",
+        "version", "QEMU " QEMU_FULL_VERSION,
+        "comments", "An independent, unofficial emulator of the "
+                    "Synthstrom Deluge,\nnot affiliated with Synthstrom "
+                    "Audible. Built on QEMU.",
+        "license-type", GTK_LICENSE_GPL_2_0,
+        "website", "https://github.com/gramster/delugemu",
+        "website-label", "github.com/gramster/delugemu",
+        NULL);
+}
+
+static GtkWidget *gd_create_menu_help(GtkDisplayState *s)
+{
+    GtkWidget *help_menu = gtk_menu_new();
+    GtkWidget *item;
+
+    item = gtk_menu_item_new_with_mnemonic(_("DelugEmu _Help"));
+    g_signal_connect(item, "activate",
+                     G_CALLBACK(gd_menu_delugemu_help), s);
+    gtk_menu_shell_append(GTK_MENU_SHELL(help_menu), item);
+
+    item = gtk_menu_item_new_with_mnemonic(_("Open _Repository"));
+    g_signal_connect(item, "activate",
+                     G_CALLBACK(gd_menu_delugemu_repo), s);
+    gtk_menu_shell_append(GTK_MENU_SHELL(help_menu), item);
+
+    item = gtk_menu_item_new_with_mnemonic(_("Open _SD Card Folder"));
+    g_signal_connect(item, "activate",
+                     G_CALLBACK(gd_menu_delugemu_sd_folder), s);
+    {
+        /* Only enabled when the launcher provided a folder-backed SD card. */
+        const char *sd_dir = getenv("DELUGEMU_SD_FOLDER");
+        gtk_widget_set_sensitive(item, sd_dir && sd_dir[0]);
+    }
+    gtk_menu_shell_append(GTK_MENU_SHELL(help_menu), item);
+
+    gtk_menu_shell_append(GTK_MENU_SHELL(help_menu),
+                          gtk_separator_menu_item_new());
+
+    item = gtk_menu_item_new_with_mnemonic(_("_About DelugEmu"));
+    g_signal_connect(item, "activate",
+                     G_CALLBACK(gd_menu_delugemu_about), s);
+    gtk_menu_shell_append(GTK_MENU_SHELL(help_menu), item);
+
+    return help_menu;
+}
