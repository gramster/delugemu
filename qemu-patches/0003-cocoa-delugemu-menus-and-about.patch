+/* DelugEmu Settings menu: persisted as KEY=VALUE lines in the file named by
+ * DELUGEMU_CONFIG (exported by run.sh, which reads it back as launch
+ * defaults), so changes apply on the next launch. */
+static NSString *delugemu_config_path(void)
+{
+    const char *p = getenv("DELUGEMU_CONFIG");
+    return (p && p[0]) ? [NSString stringWithUTF8String:p] : nil;
+}
+
+static NSMutableDictionary *delugemu_config_read(void)
+{
+    NSMutableDictionary *conf = [NSMutableDictionary dictionary];
+    NSString *path = delugemu_config_path();
+    NSString *text = path ? [NSString stringWithContentsOfFile:path
+                                encoding:NSUTF8StringEncoding error:nil] : nil;
+
+    for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+        NSRange eq = [line rangeOfString:@"="];
+        if (eq.location != NSNotFound && eq.location > 0 &&
+            ![line hasPrefix:@"#"]) {
+            [conf setObject:[line substringFromIndex:eq.location + 1]
+                     forKey:[line substringToIndex:eq.location]];
+        }
+    }
+    return conf;
+}
+
+static void delugemu_config_set(NSString *key, NSString *value)
+{
+    NSString *path = delugemu_config_path();
+    NSMutableDictionary *conf;
+    NSMutableString *out;
+
+    if (!path) {
+        return;
+    }
+    conf = delugemu_config_read();
+    if (value) {
+        [conf setObject:value forKey:key];
+    } else {
+        [conf removeObjectForKey:key];
+    }
+    out = [NSMutableString stringWithString:
+        @"# DelugEmu launcher settings (written by the Settings menu)\n"];
+    for (NSString *k in [[conf allKeys]
+             sortedArrayUsingSelector:@selector(compare:)]) {
+        [out appendFormat:@"%@=%@\n", k, [conf objectForKey:k]];
+    }
+    [[NSFileManager defaultManager]
+        createDirectoryAtPath:[path stringByDeletingLastPathComponent]
+        withIntermediateDirectories:YES attributes:nil error:nil];
+    [out writeToFile:path atomically:YES
+            encoding:NSUTF8StringEncoding error:nil];
+}
+
+- (void)delugemuToggleClamp:(id)sender
+{
+    BOOL on = [sender state] != NSControlStateValueOn;
+    delugemu_config_set(@"TX_RENDER_HEAD", on ? @"auto" : @"off");
+    [sender setState:on ? NSControlStateValueOn : NSControlStateValueOff];
+}
+
+- (void)delugemuToggleIcount:(id)sender
+{
+    BOOL on = [sender state] != NSControlStateValueOn;
+    delugemu_config_set(@"ICOUNT", on ? @"auto" : nil);
+    [sender setState:on ? NSControlStateValueOn : NSControlStateValueOff];
+}
+
+- (void)delugemuSetAudioBuffer:(id)sender
+{
+    delugemu_config_set(@"AUDIO_BUFFER",
+                        [NSString stringWithFormat:@"%d", (int)[sender tag]]);
+    for (NSMenuItem *item in [[sender menu] itemArray]) {
+        [item setState:item == sender ? NSControlStateValueOn
+                                      : NSControlStateValueOff];
+    }
+}
