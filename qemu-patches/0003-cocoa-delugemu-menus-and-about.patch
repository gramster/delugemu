+/* DelugEmu Help-menu actions. Launcher-dependent locations (the SD card
+ * folder, an overriding help document) arrive via environment variables
+ * exported by run.sh / the .app launcher, so the same binary serves the
+ * repo tree, the CLI bundle and the app bundle. */
+static void delugemu_open_url(const char *url)
+{
+    [[NSWorkspace sharedWorkspace] openURL:
+        [NSURL URLWithString:[NSString stringWithUTF8String:url]]];
+}
+
+- (void)delugemuHelp:(id)sender
+{
+    const char *url = getenv("DELUGEMU_HELP_URL");
+    delugemu_open_url(url && url[0] ? url
+                                    : "https://github.com/gramster/delugemu#readme");
+}
+
+- (void)delugemuOpenRepository:(id)sender
+{
+    delugemu_open_url("https://github.com/gramster/delugemu");
+}
+
+- (void)delugemuOpenSDFolder:(id)sender
+{
+    const char *dir = getenv("DELUGEMU_SD_FOLDER");
+    if (dir && dir[0]) {
+        [[NSWorkspace sharedWorkspace] openURL:
+            [NSURL fileURLWithPath:[NSString stringWithUTF8String:dir]
+                       isDirectory:YES]];
+    }
+}
