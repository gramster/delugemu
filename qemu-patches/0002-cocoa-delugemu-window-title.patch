+++ b/ui/cocoa.m
@@ -350,6 +350,15 @@
     return cgEvent;
 }
 
+/* Window/About title: "DelugEmu <version>" when the launcher exported the
+ * release tag (DELUGEMU_VERSION), plain "DelugEmu" otherwise. */
+static NSString *delugemu_app_title(void)
+{
+    const char *v = getenv("DELUGEMU_VERSION");
+    return (v && v[0]) ? [NSString stringWithFormat:@"DelugEmu %s", v]
+                       : @"DelugEmu";
+}
